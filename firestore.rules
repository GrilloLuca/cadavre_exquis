rules_version = '2';

// Mirrors the checks in lib/services/*_service.dart so they can't be skipped
// by a modified client. Players are identified by their auth email, which is
// what the app stores in `lockedBy`, `parts[].author` and `createdBy`.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    // ---------------------------------------------------------------------
    // stories/{storyId}  (StoryService)
    // ---------------------------------------------------------------------
    match /stories/{storyId} {
      // Must match kStoryPositions in lib/models/story.dart.
      function positions() {
        return ['introduzione', 'sviluppo1', 'sviluppo2', 'epilogo'];
      }

      function wroteLastPart(parts) {
        return parts.size() > 0 && parts[parts.size() - 1].author == myEmail();
      }

      // A lock holds for 1 hour (Story.lockDuration). One without
      // `lockedAt`, taken by an app version older than lock expiry, counts
      // as expired.
      function lockExpired() {
        return resource.data.get('lockedAt', null) == null
          || request.time >= resource.data.lockedAt + duration.value(1, 'h');
      }

      function freeForMe() {
        return resource.data.get('lockedBy', null) == null
          || resource.data.lockedBy == myEmail()
          || lockExpired();
      }

      // createStory
      function isValidCreate() {
        let d = request.resource.data;
        return d.keys().hasOnly(['status', 'currentPosition', 'parts',
              'lockedBy', 'lockedAt', 'language', 'roomId', 'createdAt',
              'updatedAt'])
          && d.status == 'incomplete'
          && d.currentPosition == positions()[0]
          && d.parts == []
          && d.lockedBy == null
          && d.get('lockedAt', null) == null
          && d.language is string
          && (d.get('roomId', null) == null || exists(/databases/$(database)/documents/privateRooms/$(d.roomId)))
          && d.createdAt == request.time
          && d.updatedAt == request.time;
      }

      // lockStory / unlockStory: only `lockedBy` and `lockedAt` change.
      // Older app versions write `lockedBy` alone, which is still allowed.
      function isValidLockChange() {
        let newLock = request.resource.data.lockedBy;
        let newLockedAt = request.resource.data.get('lockedAt', null);
        let lockedAtChanged = request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(['lockedAt']);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lockedBy', 'lockedAt'])
          && (
            // lock: story still open, not held by someone else (or held but
            // expired), not my second turn in a row; `lockedAt` is now
            (newLock == myEmail()
              && resource.data.status == 'incomplete'
              && freeForMe()
              && !wroteLastPart(resource.data.parts)
              && (!lockedAtChanged || newLockedAt == request.time))
            // unlock: only the holder can release it
            || (newLock == null
              && resource.data.get('lockedBy', null) == myEmail()
              && (!lockedAtChanged || newLockedAt == null))
          );
      }

      // submitPart: appends exactly one part by me at the current position
      // and advances (or completes) the story.
      function isValidSubmit() {
        let before = resource.data;
        let after = request.resource.data;
        let n = before.parts.size();
        let part = after.parts[n];
        let isLast = n == positions().size() - 1;
        return after.diff(before).affectedKeys()
              .hasOnly(['parts', 'currentPosition', 'status', 'lockedBy',
                'lockedAt', 'updatedAt'])
          && before.status == 'incomplete'
          && n < positions().size()
          && before.currentPosition == positions()[n]
          && freeForMe()
          && !wroteLastPart(before.parts)
          && after.parts.size() == n + 1
          // A [0:0] slice doesn't compare equal to [], so the first part is
          // checked separately.
          && (n == 0 || after.parts[0:n] == before.parts)
          && part.keys().hasOnly(['position', 'text', 'author', 'timestamp'])
          && part.position == before.currentPosition
          && part.author == myEmail()
          && part.text is string
          && part.text.size() > 0
          && part.text.size() <= 5000
          && part.timestamp is timestamp
          && after.currentPosition == (isLast ? positions()[n] : positions()[n + 1])
          && after.status == (isLast ? 'complete' : 'incomplete')
          && after.lockedBy == null
          // Cleared, or left as is by older app versions.
          && (!after.diff(before).affectedKeys().hasAny(['lockedAt'])
            || after.lockedAt == null)
          && after.updatedAt == request.time;
      }

      // Lists are queried by `status` plus `roomId` (private rooms) or
      // `language` + `roomId == null` (public rooms); complete lists also by
      // `mature in [false, true]` (stories with an AI review verdict), with
      // mature stories shown locked in the same list. Every signed-in
      // player can read any story: the age gate on mature stories is
      // enforced by the app, not here.
      allow read: if signedIn();
      allow create: if signedIn() && isValidCreate();
      allow update: if signedIn() && (isValidLockChange() || isValidSubmit());
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // privateRooms/{roomId}  (PrivateRoomService)
    // ---------------------------------------------------------------------
    match /privateRooms/{roomId} {
      // Rooms are only ever fetched by id (the normalized name): joining
      // needs the salt and hash, and createRoom reads the id to detect a
      // name collision. Listing would expose every room name.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'passwordHash', 'salt', 'createdBy', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.trim().lower() == roomId
        && request.resource.data.passwordHash is string
        && request.resource.data.salt is string
        && request.resource.data.createdBy == myEmail()
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // userProfiles/{emailKey}  (UserProfileService)
    // ---------------------------------------------------------------------
    match /userProfiles/{emailKey} {
      function isProfileOwner() {
        return signedIn() && myEmail().lower() == emailKey;
      }

      function isValidProfile() {
        return request.resource.data.keys().hasOnly(['nickname', 'updatedAt'])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() >= 2
          && request.resource.data.nickname.size() <= 20
          && request.resource.data.updatedAt == request.time;
      }

      // The nickname can be chosen only once: a profile is written only
      // while its nickname is missing or empty. Deleting it (which would
      // allow choosing again) is left to the anonymizeDeletedUser function.
      allow get: if signedIn();
      allow list, delete: if false;
      allow create: if isProfileOwner() && isValidProfile();
      allow update: if isProfileOwner() && isValidProfile()
        && resource.data.get('nickname', '') == '';
    }

    // ---------------------------------------------------------------------
    // ageChecks/{emailKey}  (AgeCheckService)
    // ---------------------------------------------------------------------
    // The neutral age screen's answer: readable by its owner only, and
    // written once, so a child can't retry with an older birth year.
    match /ageChecks/{emailKey} {
      function isOwner() {
        return signedIn() && myEmail().lower() == emailKey;
      }

      allow get: if isOwner();
      allow list, update, delete: if false;
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['birthYear', 'createdAt'])
        && request.resource.data.birthYear is int
        && request.resource.data.birthYear >= 1900
        && request.resource.data.birthYear <= request.time.year()
        && request.resource.data.createdAt == request.time;
    }

    // ---------------------------------------------------------------------
    // pushTokens/{fcmToken}  (NotificationRepository)
    // ---------------------------------------------------------------------
    // One document per device, keyed by its FCM token, naming the user it
    // notifies. Writing a token claims it for the signed-in user: only the
    // device knows its token, and a new sign-in on that device should take
    // it over. Only the Cloud Functions (Admin SDK) read tokens.
    match /pushTokens/{token} {
      function isValidToken() {
        let d = request.resource.data;
        return d.keys().hasOnly(['emailKey', 'locale', 'platform', 'updatedAt'])
          && d.emailKey == myEmail().lower()
          && d.locale is string
          && d.locale.size() <= 10
          && d.platform in ['android', 'ios']
          && d.updatedAt == request.time;
      }

      allow read: if false;
      allow create, update: if signedIn() && isValidToken();
      allow delete: if signedIn() && resource.data.emailKey == myEmail().lower();
    }

    // Everything else (including the legacy `chapters` collection) is closed.
  }
}
