# Android lanes for cadavre_exquisite.
# Run from the android/ folder: `bundle exec fastlane android <lane>`
#
# Required (CI provides these, see docs/CI_CD.md):
#   play-store-credentials.json  -> Google Play service account key (path set in Appfile)
#   android/key.properties + keystore -> release signing

default_platform(:android)

platform :android do
  PROJECT_ROOT = File.expand_path("../..", __dir__)
  AAB_PATH = File.join(PROJECT_ROOT, "build/app/outputs/bundle/release/app-release.aab")

  # Helper methods used by the lanes below — keep them.

  # "1.2.3+4" -> "1.2.3"
  def version_name
    File.read(File.join(PROJECT_ROOT, "pubspec.yaml"))[/^version:\s*([^+\s]+)/, 1]
  end

  # Fail fast with a clear message if the Play service account key is missing or invalid.
  def check_play_credentials!
    path = File.expand_path("play-store-credentials.json", __dir__)
    UI.user_error!("Missing #{path} — set the PLAY_STORE_JSON_KEY secret") unless File.exist?(path)
    JSON.parse(File.read(path))
  rescue JSON::ParserError
    UI.user_error!("play-store-credentials.json is not valid JSON — paste the raw service account JSON into PLAY_STORE_JSON_KEY")
  end


  # Version codes on EVERY Play track (incl. custom closed-testing tracks), by track name.
  def play_version_codes_by_track
    require "supply"
    require "supply/client"
    Supply.config = FastlaneCore::Configuration.create(
      Fastlane::Actions::GooglePlayTrackVersionCodesAction.available_options,
      { json_key: File.expand_path("play-store-credentials.json", __dir__) }
    )
    client = Supply::Client.make_from_config
    client.begin_edit(package_name: Supply.config[:package_name])
    result = client.tracks.to_h do |t|
      [t.track, (t.releases || []).flat_map { |r| r.version_codes || [] }.map(&:to_i)]
    end
    client.abort_current_edit
    result
  end

  # Highest version code on any track, + 1. Fails loudly instead of guessing.
  def next_version_code
    by_track = play_version_codes_by_track
    by_track.each { |track, codes| UI.message("Play track '#{track}': #{codes.empty? ? '-' : codes.join(', ')}") }
    (by_track.values.flatten.max || 0) + 1
  end

  # Writes the built version for later CI steps.
  def export_build_env(values)
    File.write(File.join(PROJECT_ROOT, "android_build.env"),
               values.map { |k, v| "#{k}=#{v}" }.join("\n") + "\n")
  end

  desc "Bump the app version name in pubspec.yaml: fastlane android bump type:patch|minor|major"
  desc "Only the name (x.y.z) changes; the build number after '+' is managed by the deploy lanes"
  lane :bump do |options|
    type = (options[:type] || "patch").to_s
    UI.user_error!("type must be patch, minor or major (got '#{type}')") unless %w[patch minor major].include?(type)

    pubspec = File.join(PROJECT_ROOT, "pubspec.yaml")
    content = File.read(pubspec)
    match = content.match(/^version:\s*(\d+)\.(\d+)\.(\d+)(\+\d+)?[ \t]*$/)
    UI.user_error!("Could not find a 'version: x.y.z+n' line in pubspec.yaml") unless match

    major, minor, patch = match[1].to_i, match[2].to_i, match[3].to_i
    case type
    when "major" then major, minor, patch = major + 1, 0, 0
    when "minor" then minor, patch = minor + 1, 0
    else patch += 1
    end
    old_version = "#{match[1]}.#{match[2]}.#{match[3]}"
    new_version = "#{major}.#{minor}.#{patch}"

    File.write(pubspec, content.sub(match[0], "version: #{new_version}#{match[4]}"))
    UI.success("Version bumped (#{type}): #{old_version} -> #{new_version}")
    new_version
  end

  desc "Runs all the tests"
  lane :test do
    sh("cd #{PROJECT_ROOT} && flutter test")
  end

  desc "Build a signed AAB and upload it to the Play internal testing track"
  lane :internal do
    check_play_credentials!
    code = (ENV["BUILD_NUMBER"] || next_version_code).to_i
    name = version_name
    UI.message("Building #{name} (#{code})")

    sh("cd #{PROJECT_ROOT} && flutter build appbundle --release " \
       "--build-name=#{name} --build-number=#{code}")

    upload_to_play_store(
      track: "internal",
      aab: AAB_PATH,
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"), # use "draft" while the app is still a draft in Play Console
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    export_build_env(ANDROID_VERSION_CODE: code, ANDROID_VERSION_NAME: name)
  end

  desc "Promote a build already on the internal track to production (no rebuild)"
  desc "Pass ANDROID_VERSION_CODE to choose the build; defaults to the latest internal build"
  lane :production do
    check_play_credentials!
    code = (ENV["ANDROID_VERSION_CODE"] || google_play_track_version_codes(track: "internal").max).to_i
    UI.user_error!("No build found on the internal track") if code.zero?
    UI.message("Promoting version code #{code}: internal -> production")

    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      version_code: code,
      rollout: ENV["PLAY_ROLLOUT"], # e.g. "0.1" for a 10% staged rollout; nil = full
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
