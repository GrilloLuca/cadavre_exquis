# Android lanes for cadavre_exquisite.
# Run from the android/ folder: `bundle exec fastlane android <lane>`
#
# Required (CI provides these, see docs/CI_CD.md):
#   play-store-credentials.json  -> Google Play service account key (path set in Appfile)
#   android/key.properties + keystore -> release signing

default_platform(:android)

platform :android do
  desc "Runs all the tests"
  lane :test do
    sh("cd #{PROJECT_ROOT} && flutter test")
  end

  desc "Build a signed AAB and upload it to the Play internal testing track"
  lane :internal do
    code = (ENV["BUILD_NUMBER"] || next_version_code).to_i
    name = version_name
    UI.message("Building #{name} (#{code})")

    sh("cd #{PROJECT_ROOT} && flutter build appbundle --release " \
       "--build-name=#{name} --build-number=#{code}")

    upload_to_play_store(
      track: "internal",
      aab: AAB_PATH,
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"), # use "draft" while the app is still a draft in Play Console
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    export_build_env(ANDROID_VERSION_CODE: code, ANDROID_VERSION_NAME: name)
  end

  desc "Promote a build already on the internal track to production (no rebuild)"
  desc "Pass ANDROID_VERSION_CODE to choose the build; defaults to the latest internal build"
  lane :production do
    code = (ENV["ANDROID_VERSION_CODE"] || google_play_track_version_codes(track: "internal").max).to_i
    UI.user_error!("No build found on the internal track") if code.zero?
    UI.message("Promoting version code #{code}: internal -> production")

    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      version_code: code,
      rollout: ENV["PLAY_ROLLOUT"], # e.g. "0.1" for a 10% staged rollout; nil = full
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
